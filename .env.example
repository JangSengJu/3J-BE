DB_URL=jdbc:mysql://localhost:3306/jjj
DB_USERNAME=root
DB_PASSWORD=changeme
JWT_SECRET=change-me-to-a-random-secret-with-at-least-32-bytes
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=14d
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# JSON 호출 전체 데드라인 (재시도 + 백오프 포함). 초과하면 룰 기반 폴백으로 전환됩니다.
GROQ_DEADLINE=30s
GROQ_TIMEOUT=60s
# SSE 스트림에서 데이터가 오지 않을 때 스트림을 닫는 대기 시간
GROQ_STREAM_IDLE_TIMEOUT=30s
# SSE 작업 스레드 풀 (초과 시 503)
AI_EXECUTOR_CORE_SIZE=4
AI_EXECUTOR_MAX_SIZE=16
AI_EXECUTOR_QUEUE_SIZE=32
# 무료 티어 모델만 허용 (쉼표 구분). 목록에 없는 모델은 기본 무료 모델로 대체됩니다.
GROQ_ALLOWED_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:*,http://127.0.0.1:*,null
